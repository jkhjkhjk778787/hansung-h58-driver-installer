# ===============================================
# 한성 H58 드라이버 설치기 - .gitignore
# ===============================================

# 대용량 공식 드라이버 압축 파일 제외 (총 1.3GB+)
*.zip

# 압축 해제된 드라이버 폴더 제외
Extracted/

# 컴파일 임시 및 바이너리 파일 제외
*.pdb
*.obj
*.log

# (선택) 실행 파일은 빌드 스크립트로 즉시 생성 가능하므로 제외하거나 보존
# release 용도로 .exe를 포함하려면 아래 줄 앞에 #을 붙이세요.
*.exe
!H58_원클릭_드라이버설치.exe
!Install_All_Drivers.exe

# 시스템 및 에디터 설정
.DS_Store
Thumbs.db
.vs/
.vscode/
